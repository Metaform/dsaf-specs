{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequestCreationItem",
  "type": "object",
  "required": [
    "messageId",
    "kind",
    "payload"
  ],
  "additionalProperties": false,
  "properties": {
    "messageId": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "kind": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "payload": {},
    "refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./pointer.schema.json"
      }
    },
    "respondBy": {
      "type": "string",
      "format": "date-time"
    }
  }
}
