{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskStatusEvent",
  "allOf": [
    {
      "$ref": "../../dcm/schemas/event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "subject",
        "data"
      ],
      "properties": {
        "type": {
          "const": "org.dsaf.stc.TaskStatus.v1"
        },
        "data": {
          "type": "object",
          "required": [
            "taskId",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "taskId": {
              "$ref": "./common.schema.json#/definitions/Uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "OPEN",
                "CLOSED"
              ]
            },
            "task": {
              "$ref": "./task.schema.json"
            },
            "closure": {
              "$ref": "./task.schema.json#/properties/closure"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "OPEN"
                  }
                }
              },
              "then": {
                "required": [
                  "task"
                ],
                "not": {
                  "required": [
                    "closure"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "CLOSED"
                  }
                }
              },
              "then": {
                "required": [
                  "closure"
                ],
                "not": {
                  "required": [
                    "task"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}