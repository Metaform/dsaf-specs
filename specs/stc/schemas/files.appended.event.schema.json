{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FilesAppendedEvent",
  "allOf": [
    {
      "$ref": "../../dcm/schemas/event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "subject",
        "data"
      ],
      "properties": {
        "type": {
          "const": "org.dsaf.stc.FilesAppended.v1"
        },
        "data": {
          "type": "object",
          "required": [
            "taskId",
            "streams"
          ],
          "additionalProperties": false,
          "properties": {
            "taskId": {
              "$ref": "./common.schema.json#/definitions/Uuid"
            },
            "streams": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "./common.schema.json#/definitions/StreamFiles"
              }
            }
          }
        }
      }
    }
  ]
}
