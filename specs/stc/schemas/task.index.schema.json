{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskIndex",
  "type": "object",
  "required": [
    "taskId",
    "streams"
  ],
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "streams": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "./common.schema.json#/definitions/StreamFiles"
          },
          {
            "$ref": "./common.schema.json#/definitions/StreamHead"
          }
        ]
      }
    }
  }
}
