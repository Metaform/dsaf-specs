{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task",
  "type": "object",
  "required": [
    "taskId",
    "status",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "DECLINED",
        "CLOSED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "./common.schema.json#/definitions/StatusError"
      }
    },
    "closure": {
      "type": "object",
      "required": [
        "closedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "closedAt": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "./pointer.schema.json"
              },
              {
                "required": [
                  "revision"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CLOSED"
          }
        }
      },
      "then": {
        "required": [
          "closure"
        ],
        "not": {
          "required": [
            "errors"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "DECLINED"
          }
        }
      },
      "then": {
        "required": [
          "errors"
        ],
        "not": {
          "required": [
            "closure"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OPEN"
          }
        }
      },
      "then": {
        "allOf": [
          {
            "not": {
              "required": [
                "closure"
              ]
            }
          },
          {
            "not": {
              "required": [
                "errors"
              ]
            }
          }
        ]
      }
    }
  ]
}
