{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Common definitions",
  "definitions": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "Seq": {
      "type": "integer",
      "minimum": 0
    },
    "RecordId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "StreamType": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "StatusError": {
      "type": "object",
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "specifier": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "FileEntry": {
      "type": "object",
      "required": [
        "seq",
        "fileId",
        "createdAt"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": {
          "$ref": "#/definitions/Seq"
        },
        "fileId": {
          "$ref": "#/definitions/Uuid"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "StreamFiles": {
      "type": "object",
      "required": [
        "type",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/StreamType"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/FileEntry"
          }
        }
      }
    },
    "StreamHead": {
      "type": "object",
      "required": [
        "type",
        "head"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/StreamType"
        },
        "head": {
          "$ref": "#/definitions/Seq"
        }
      }
    }
  }
}