{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pointer",
  "type": "object",
  "required": [
    "author",
    "type",
    "record"
  ],
  "additionalProperties": false,
  "properties": {
    "author": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "$ref": "./common.schema.json#/definitions/StreamType"
    },
    "record": {
      "$ref": "./common.schema.json#/definitions/RecordId"
    },
    "revision": {
      "$ref": "./common.schema.json#/definitions/Revision"
    },
    "seq": {
      "$ref": "./common.schema.json#/definitions/Seq"
    }
  },
  "if": {
    "required": [
      "seq"
    ]
  },
  "then": {
    "required": [
      "revision"
    ]
  }
}