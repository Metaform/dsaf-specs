{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pointer",
  "type": "object",
  "required": [
    "stream",
    "record"
  ],
  "additionalProperties": false,
  "properties": {
    "stream": {
      "$ref": "./common.schema.json#/definitions/Uuid"
    },
    "record": {
      "$ref": "./common.schema.json#/definitions/RecordId"
    },
    "revision": {
      "$ref": "./common.schema.json#/definitions/Revision"
    },
    "seq": {
      "$ref": "./common.schema.json#/definitions/Seq"
    }
  },
  "if": {
    "required": [
      "seq"
    ]
  },
  "then": {
    "required": [
      "revision"
    ]
  }
}
