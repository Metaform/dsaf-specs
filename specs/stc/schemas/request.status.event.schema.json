{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequestStatusEvent",
  "allOf": [
    {
      "$ref": "../../dcm/schemas/event.schema.json"
    },
    {
      "type": "object",
      "required": [
        "subject",
        "data"
      ],
      "properties": {
        "type": {
          "const": "org.dsaf.stc.RequestStatus.v1"
        },
        "data": {
          "type": "object",
          "required": [
            "taskId",
            "requestId",
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "taskId": {
              "$ref": "./common.schema.json#/definitions/Uuid"
            },
            "requestId": {
              "$ref": "./common.schema.json#/definitions/Uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "ANSWERED",
                "DECLINED"
              ]
            },
            "response": {
              "$ref": "./request.schema.json#/definitions/Response"
            },
            "errors": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "./common.schema.json#/definitions/StatusError"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "ANSWERED"
                  }
                }
              },
              "then": {
                "required": [
                  "response"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "DECLINED"
                  }
                }
              },
              "then": {
                "required": [
                  "errors"
                ],
                "not": {
                  "required": [
                    "response"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}
